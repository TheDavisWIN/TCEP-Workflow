<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="utd.tcep.controllers.TCEPHistoryController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 20; -fx-background-color: #f4f4f4;">
            <Button fx:id="backToFormButton" text="Back to Form" onAction="#handleBackToForm"
                    style="-fx-font-size: 14px; -fx-padding: 10 20;"/>
            <Label text="ECS TCEP HISTORY" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <TableView fx:id="historyTable" prefHeight="700" prefWidth="900">
                <columns>
                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="220"/>
                    <TableColumn fx:id="actionColumn" text="Action" prefWidth="450"/>
                    <TableColumn fx:id="reviewerColumn" text="Reviewer" prefWidth="230"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>

<!-- 
View history page to show history of tcep forms when they go through the process of getting accepeted or denied
