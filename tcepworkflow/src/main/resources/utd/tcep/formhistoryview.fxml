<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>


<!-- Form history view page
     Andrew Robertson (AMR220023) -->

<BorderPane fx:id="rootpane" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="utd.tcep.controllers.TCEPHistoryController">

    <center>
        <VBox spacing="25" style="-fx-padding: 30;" VBox.vgrow="ALWAYS">
            <children>

                <!-- BACK BUTTON (you had this before — now restored) -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <children>
                        <Button text="Back to Form" style="-fx-text-fill: black;" fx:id="backToFormButton"/>
                    </children>
                </HBox>

                <!-- MAIN HEADER: Logo left, Student name center, Started/By right -->
                <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10 0 30 0;">
                    <children>

                        <!-- LEFT: Logo + Title -->
                        <HBox alignment="CENTER_LEFT" spacing="20">
                            <children>
                                <ImageView fx:id="utdLogo" fitHeight="50" preserveRatio="true">
                                    <image>
                                        <Image url="@images/utd_logo.png"/>
                                    </image>
                                </ImageView>
                                <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="ECS TCEP HISTORY" />
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- CENTER: Student Name + ID -->
                        <VBox alignment="CENTER">
                            <children>
                                <Label fx:id="studentNameLabel" 
                                       text="History for: Loading..." 
                                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: black;"/>
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- RIGHT: Started / By -->
                        <VBox alignment="TOP_RIGHT" spacing="5">
                            <Label style="-fx-font-size: 14px;" text="Started: October 26, 2025" />
                            <Label style="-fx-font-size: 14px;" text="By: First Last" />
                        </VBox>
                    </children>
                </HBox>

                <!-- HISTORY TABLE -->
                <VBox spacing="15" style="-fx-padding: 20 0 0 0;" VBox.vgrow="ALWAYS">
                    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="dateColumn" text="Date" />
                            <TableColumn fx:id="actionColumn" text="Action" />
                            <TableColumn fx:id="reviewerColumn" text="Reviewer" />
                        </columns>
                    </TableView>
                </VBox>

            </children>
        </VBox>
    </center>
</BorderPane>