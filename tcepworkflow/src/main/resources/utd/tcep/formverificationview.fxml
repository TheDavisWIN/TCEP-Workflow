<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <AnchorPane AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0">
      <children>
        <VBox fx:id="dialog" maxWidth="600" maxHeight="500" spacing="15.0" alignment="TOP_CENTER" 
              AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="300.0" 
              AnchorPane.topAnchor="200.0" AnchorPane.bottomAnchor="200.0" 
              style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 25;">
          <children>
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: black;" 
                   text="Course Equivalency Verification" />
            
            <Label style="-fx-text-fill: #666; -fx-font-size: 12px;" 
                   text="Verification results for the entered course information:" 
                   wrapText="true" />

            <!-- Results display area -->
            <TextArea fx:id="verificationResultsArea" 
                      editable="false" 
                      wrapText="true" 
                      prefHeight="300" 
                      prefWidth="550"
                      style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 13px; -fx-control-inner-background: #f5f5f5;">
              <VBox.margin>
                <Insets top="10" />
              </VBox.margin>
            </TextArea>

            <!-- Status indicator -->
            <HBox spacing="10" alignment="CENTER_LEFT">
              <children>
                <Label fx:id="statusIcon" style="-fx-font-size: 18px;" text="ℹ" />
                <Label fx:id="statusLabel" style="-fx-font-size: 13px; -fx-text-fill: #333;" 
                       text="Verification complete" wrapText="true" />
              </children>
              <VBox.margin>
                <Insets top="5" />
              </VBox.margin>
            </HBox>

            <!-- Button area -->
            <HBox spacing="15" alignment="CENTER">
              <children>
                <Button text="Close" 
                        onAction="#closeOverlay" 
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30;" />
              </children>
              <VBox.margin>
                <Insets top="10" />
              </VBox.margin>
            </HBox>
          </children>
        </VBox>
      </children>
    </AnchorPane>
  </children>
</AnchorPane>